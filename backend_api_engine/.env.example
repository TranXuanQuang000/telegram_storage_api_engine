# Optional shared secret required from the frontend Worker.
MUC_API_TOKEN=

# Comma-separated browser origins allowed to call this API directly.
ALLOWED_ORIGINS=https://muctruyen.pages.dev,http://localhost:3000

# Comic compatibility upstream used while migrating away from OTruyen.
OTRUYEN_UPSTREAM_URL=https://otruyenapi.com/v1/api

# Maximum number of in-process cached responses.
CACHE_MAX_ENTRIES=512

# Comma-separated source IDs, or * to enable every registered connector.
ENABLED_SOURCES=otruyen,mangadex,hako,truyenfull,metruyenchu,tangthuvien,wikidich

# Required in production to make multi-source chapter IDs tamper evident.
OPAQUE_ID_SECRET=

# Authorized archive. Keep these server-side and never expose the bot token.
# Default policy only permits xkcd images under CC BY-NC 2.5.
ARCHIVE_API_TOKEN=
ARCHIVE_ALLOWED_SOURCES=xkcd
ARCHIVE_MAX_IMAGE_BYTES=19000000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# For an owned/licensed connector, explicitly allow only its real HTTPS asset hosts:
# ARCHIVE_ASSET_HOSTS_MY_SOURCE=cdn.example.com,images.example.com
