# Optional shared secret required from the frontend Worker.
MUC_API_TOKEN=

# Comma-separated browser origins allowed to call this API directly.
ALLOWED_ORIGINS=https://muctruyen.pages.dev,http://localhost:3000

# Comic compatibility upstream used while migrating away from OTruyen.
OTRUYEN_UPSTREAM_URL=https://otruyenapi.com/v1/api

# Maximum number of in-process cached responses.
CACHE_MAX_ENTRIES=512

# Comma-separated source IDs, or * to enable every registered connector.
ENABLED_SOURCES=hako,gutendex

# Public novel source origins. Hako documents docln.sbs as its alternate
# public domain. Keep unavailable sources disabled until their public origin
# is verified; the service never solves challenges or submits login forms.
HAKO_BASE_URL=https://docln.sbs
TRUYENFULL_BASE_URL=https://truyenfull.win
METRUYENCHU_BASE_URL=https://metruyenchu.com.vn
TANGTHUVIEN_BASE_URL=https://truyen.tangthuvien.vn
WIKIDICH_BASE_URL=https://wikidich.vn
SOURCE_OPERATION_TIMEOUT_SECONDS=10

# Optional deployment snapshot built by scripts/build_novel_catalog_snapshot.py.
# The API falls back to live connectors when this file is missing or invalid.
NOVEL_CATALOG_SNAPSHOT_ENABLED=true
NOVEL_CATALOG_SNAPSHOT_PATH=data/novel_catalog.snapshot.json.gz
NOVEL_SYNC_MAX_PAGES_PER_SOURCE=10000
NOVEL_SYNC_DELAY_MS=750
NOVEL_SYNC_RETRIES=3
NOVEL_SYNC_DETAIL_CONCURRENCY=3
NOVEL_SYNC_DETAIL_DELAY_MS=250

# Required in production to make multi-source chapter IDs tamper evident.
OPAQUE_ID_SECRET=

# Authorized archive. Keep these server-side and never expose the bot token.
# Default policy only permits xkcd images under CC BY-NC 2.5.
ARCHIVE_API_TOKEN=
ARCHIVE_ALLOWED_SOURCES=xkcd
ARCHIVE_MAX_IMAGE_BYTES=19000000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# For an owned/licensed connector, explicitly allow only its real HTTPS asset hosts:
# ARCHIVE_ASSET_HOSTS_MY_SOURCE=cdn.example.com,images.example.com
