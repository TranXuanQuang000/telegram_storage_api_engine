{
  "meta": {
    "direction": "Inkroom Editorial",
    "rationale": "Warm paper and precise ink make the catalog feel collected, while vermilion marks active state and new chapters.",
    "source": "UI_DIRECTION.md"
  },
  "colors": {
    "primitive": {
      "paper50": "#fbf8f1",
      "paper100": "#f1eadc",
      "paper200": "#e2d7c4",
      "ink900": "#171714",
      "ink700": "#34332e",
      "ink500": "#756f64",
      "vermillion500": "#e4512e",
      "vermillion600": "#c93f20",
      "moss500": "#526b50",
      "night900": "#131311",
      "white": "#ffffff"
    },
    "semantic": {
      "bg": "#f1eadc",
      "surface": "#fbf8f1",
      "surfaceStrong": "#e2d7c4",
      "text": "#171714",
      "textMuted": "#756f64",
      "border": "rgba(23, 23, 20, 0.18)",
      "action": "#e4512e",
      "actionHover": "#c93f20",
      "success": "#526b50",
      "focus": "#171714",
      "readerBg": "#131311",
      "readerText": "#fbf8f1"
    }
  },
  "typography": {
    "fontFamily": {
      "display": "Georgia, 'Times New Roman', serif",
      "body": "var(--font-geist-sans), 'Segoe UI', sans-serif",
      "mono": "var(--font-geist-mono), Consolas, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "2xl": "clamp(1.75rem, 4vw, 2.75rem)",
      "display": "clamp(3rem, 7vw, 6.75rem)"
    },
    "fontWeight": { "regular": 400, "medium": 560, "bold": 720 },
    "lineHeight": { "tight": 0.92, "heading": 1.08, "body": 1.6, "ui": 1.35 },
    "letterSpacing": { "display": "-0.055em", "heading": "-0.025em", "caps": "0.09em" },
    "roles": {
      "display": "display / display / tight",
      "heading": "display / 2xl / heading",
      "body": "body / base / body",
      "label": "body / sm / ui",
      "meta": "mono / xs / ui"
    }
  },
  "spacing": { "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem", "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem", "16": "4rem", "24": "6rem" },
  "sizing": { "touch": "2.75rem", "coverSm": "7.5rem", "coverLg": "16rem", "content": "80rem" },
  "layout": {
    "container": { "max": "90rem", "reader": "74rem" },
    "gutter": { "mobile": "1rem", "tablet": "1.5rem", "desktop": "2rem" },
    "grid": { "desktop": 12, "tablet": 8, "mobile": 4 },
    "density": { "compact": "0.75rem", "comfortable": "1rem", "airy": "1.5rem" },
    "breakpoints": { "sm": "40rem", "md": "48rem", "lg": "64rem", "xl": "80rem" }
  },
  "shadows": { "cover": "0 18px 36px rgba(83, 61, 39, 0.22)", "lift": "0 8px 24px rgba(83, 61, 39, 0.14)" },
  "borders": { "hairline": "1px solid rgba(23, 23, 20, 0.18)", "strong": "1px solid rgba(23, 23, 20, 0.72)" },
  "blur": { "chrome": "12px" },
  "zIndex": { "base": 0, "header": 30, "dock": 40, "dialog": 60, "toast": 70 },
  "animation": {
    "duration": { "instant": "90ms", "productive": "180ms", "spatial": "300ms", "expressive": "520ms" },
    "easing": { "out": "cubic-bezier(0.2, 0.8, 0.2, 1)", "inOut": "cubic-bezier(0.65, 0, 0.35, 1)" },
    "spring": { "soft": "duration 300ms, overshoot 0.04" },
    "distance": { "short": "0.25rem", "medium": "0.75rem" },
    "stagger": { "short": "24ms" },
    "reducedMotion": { "duration": "90ms", "distance": "0" }
  },
  "borderRadius": { "sm": "0.5rem", "md": "0.75rem", "lg": "1.125rem", "pill": "999px" },
  "component": {
    "headerHeight": "4.5rem",
    "mobileDockHeight": "4.5rem",
    "chipHeight": "2.25rem",
    "coverAspect": "2 / 3"
  }
}

