# Server-side secret. Generate a long random value and configure it in hosting.
INGEST_TOKEN=

# Public origin used by metadata when request headers are unavailable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only URL of the replacement content API. Cloudflare production must use
# a public HTTPS URL; localhost is only valid while developing locally.
MUC_CONTENT_API_URL=http://localhost:8000

# Optional shared secret. Keep this server-side; never prefix it with NEXT_PUBLIC_.
MUC_CONTENT_API_TOKEN=

# false = fall back to the legacy comic API during migration.
# true  = only use MUC_CONTENT_API_URL.
MUC_CONTENT_API_STRICT=false

# Novel providers exposed by the replacement API.
MUC_NOVEL_API_SOURCES=hako,truyenfull,metruyenchu,tangthuvien,wikidich
MUC_NOVEL_API_SCAN_PAGES=2
