# Server-side secret. Generate a long random value and configure it in hosting.
INGEST_TOKEN=

# Secret used by the browser to unlock /admin/cyber-nexus.
# Keep it independent from the backend token and configure it as a hosting secret.
ADMIN_DASHBOARD_TOKEN=

# Backend-only credential used by the Cloudflare server route to read Manga API telemetry.
# Never expose this value with a NEXT_PUBLIC_ prefix.
MANGA_API_ADMIN_TOKEN=

# Public origin used by metadata when request headers are unavailable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side comic catalog/chapter provider. Do not prefix these with NEXT_PUBLIC_.
MANGA_API_BASE_URL=http://localhost:3100
CATALOG_PROVIDER=manga-api

# Legacy content API settings are retained only for rollback when CATALOG_PROVIDER=legacy.

# Novel aggregator API. Replace this local URL with its public HTTPS origin
# when deploying the frontend.
MUC_CONTENT_API_URL=http://localhost:8000/v1/api
NEXT_PUBLIC_OTRUYEN_API_URL=

# Optional shared secret. Keep this server-side; never prefix it with NEXT_PUBLIC_.
MUC_CONTENT_API_TOKEN=

# false = fall back to the legacy comic API during migration.
# true  = only use MUC_CONTENT_API_URL.
MUC_CONTENT_API_STRICT=true

# Novel providers exposed by the replacement API.
MUC_NOVEL_API_SOURCES=hako,gutendex
MUC_NOVEL_API_SCAN_PAGES=3
