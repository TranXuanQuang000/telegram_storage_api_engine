ENABLED_SOURCES=otruyen,mangadex,hako,truyenfull,tangthuvien,metruyenchu,wikidich
ALLOWED_ORIGINS=https://muctruyen.pages.dev,http://localhost:3000

# Optional shared server-side API token. Leave blank for a public read API.
MUC_API_TOKEN=
CACHE_MAX_ENTRIES=512
SOURCE_OPERATION_TIMEOUT_SECONDS=5

# Authorized archive. Defaults to a pre-verified CC source only.
ARCHIVE_API_TOKEN=
ARCHIVE_ALLOWED_SOURCES=xkcd
ARCHIVE_MAX_IMAGE_BYTES=19000000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Owned/licensed connector example:
# ARCHIVE_ASSET_HOSTS_MY_SOURCE=cdn.example.com,images.example.com
